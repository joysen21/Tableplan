# Kopie als ".env.local" anlegen (lokal) bzw. in Vercel/Netlify als Umgebungsvariablen setzen.
# Ohne diese Werte startet die App im Demo-Modus (Daten nur im Browser).
VITE_SUPABASE_URL=https://IHR-PROJEKT.supabase.co
# anon/publishable Key – NIEMALS den service_role/secret Key verwenden
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Wie viele Tage zurück Reservierungen geladen werden
VITE_HISTORY_DAYS=120
