<?xml version="1.0" encoding="utf-8"?>
<!-- IIS-Konfiguration für Tischplan -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files><clear /><add value="index.html" /></files>
    </defaultDocument>
    <staticContent>
      <!-- Updates sofort wirksam: Browser fragt Dateien bei jedem Laden neu ab -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".git" />
          <add segment="supabase" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
